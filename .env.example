# Copy to .env and fill in. .env is gitignored.

# Where the local SQLite message store lives.
MARS_DB_PATH=data/mars.db

# --- WhatsApp Cloud API (ingestion service) ---
# From your Meta App > WhatsApp > Configuration.
# You choose VERIFY_TOKEN yourself; paste the same value into the Meta webhook config.
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
# App Secret (Meta App > Settings > Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
# Permanent access token + phone number id, used only if you send replies via MARS.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Optional: emailed daily follow-up digest (SMTP) ---
# Defaults target Gmail. For Gmail, create an App Password
# (Google Account > Security > 2-Step Verification > App passwords) and use it
# as MARS_SMTP_PASSWORD — not your normal account password.
MARS_SMTP_HOST=smtp.gmail.com
MARS_SMTP_PORT=587
MARS_SMTP_STARTTLS=true
MARS_SMTP_USER=you@gmail.com
MARS_SMTP_PASSWORD=your-16-char-app-password
MARS_SMTP_FROM=you@gmail.com
MARS_DIGEST_TO=you@gmail.com

# --- Optional: LLM narrative summaries / briefings ---
# Without this, analytics + CRM + heuristic prep still work; only the
# natural-language summary/briefing falls back to a deterministic digest.
ANTHROPIC_API_KEY=
MARS_SUMMARY_MODEL=claude-sonnet-4-6
